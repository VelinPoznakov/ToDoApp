@{
    ViewData["Title"] = "Bad Request";
}

@section Styles {
    <link rel="stylesheet" href="~/css/error-pages/error-pages.css" asp-append-version="true" />
}

<div class="error-page">

    <div class="error-card error-card--bad-request">

        <span class="error-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </span>

        <p class="error-card__code">400</p>
        <h1 class="error-card__title">Bad request</h1>
        <p class="error-card__text">We couldn't process that request. Please check the link or the information you entered and try again.</p>

        <a class="error-card__btn" asp-area="" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span>Back to Home</span>
        </a>

    </div>

</div>
