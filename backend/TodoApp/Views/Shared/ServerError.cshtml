@{
    ViewData["Title"] = "Something Went Wrong";
}

@section Styles {
    <link rel="stylesheet" href="~/css/error-pages/error-pages.css" asp-append-version="true" />
}

<div class="error-page">

    <div class="error-card error-card--server-error">

        <span class="error-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </span>

        <p class="error-card__code">500</p>
        <h1 class="error-card__title">Something went wrong</h1>
        <p class="error-card__text">An unexpected error occurred on our side. Please try again in a moment.</p>

        <a class="error-card__btn" asp-area="" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span>Back to Home</span>
        </a>

    </div>

</div>
