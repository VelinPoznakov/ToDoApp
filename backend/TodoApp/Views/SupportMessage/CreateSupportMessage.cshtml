@using TodoApp.Web.ViewModels.SupportMessage
@model CreateSupportMessageViewModel

@{
    ViewData["Title"] = "Contact Support";

    Layout = "/Areas/TodoMainApp/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/create-support-message/create-support-message.css" asp-append-version="true" />
}

<div class="create-page">

    <div class="create-header">
        <a class="create-header__back" href="#" data-back aria-label="Go back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
        </a>
        <div class="create-header__heading">
            <h3 class="create-header__title">Contact Support</h3>
            <p class="create-header__subtitle">Tell us what went wrong and we will get back to you</p>
        </div>
    </div>

    <div class="create-card">

        <form class="create-form"
              asp-controller="SupportMessage"
              asp-action="CreateSupportMessage"
              method="post">

            <div asp-validation-summary="ModelOnly" class="create-form__summary"></div>

            <div class="form-field">
                <label class="form-field__label" asp-for="Title">Title</label>
                <input class="form-field__input" asp-for="Title" placeholder="Short summary of the issue" />
                <span class="form-field__error" asp-validation-for="Title"></span>
            </div>

            <div class="form-field">
                <label class="form-field__label" asp-for="Description">Description</label>
                <textarea class="form-field__input form-field__input--textarea"
                          asp-for="Description"
                          placeholder="Describe the problem — what you did, what you expected, and what happened instead"></textarea>
                <span class="form-field__error" asp-validation-for="Description"></span>
            </div>

            <div class="create-actions">
                <a class="create-btn create-btn--cancel" href="#" data-back>Cancel</a>
                <button type="submit" class="create-btn create-btn--save">Send Message</button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
