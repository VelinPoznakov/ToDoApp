@using TodoApp.Models.Data.Enums
@using TodoApp.Models.Todo
@using TodoApp.Web.ViewModels.Todo
@using static TodoApp.GCommon.ApplicationConstants
@model PagedTodosViewModel

@{
    string? filter = Context.Request.Query["filter"];

    // the endpoint only lets Pending and Completed through
    Enum.TryParse(filter, true, out TodosSearchParameter activeFilter);

    string PageUrl(int page) => Url.Action("TodosByStatus", "Todo", new { area = "TodoMainApp", filter, page })!;
}

@section Styles {
    <link rel="stylesheet" href="~/css/todos-by-status/todos-by-status.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pagination/pagination.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/delete-todo-warning/delete-todo-warning.css" asp-append-version="true" />
}

<div class="status-page">

    <div class="status-header">
        <a class="status-header__back"
           asp-area="TodoMainApp"
           asp-controller="Dashboard"
           asp-action="Index"
           aria-label="Back to dashboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
        </a>
        <div>
            <h3 class="status-header__title">@activeFilter Todos</h3>
            <p class="status-header__subtitle">All @activeFilter.ToString().ToLower() todos from your groups</p>
        </div>
    </div>

    <div class="todos-section">

        @if (Model.Todos.Any())
        {
            <div class="todos-table__head">
                <p class="todos-col">Title</p>
                <p class="todos-col">Status</p>
                <p class="todos-col">Priority</p>
                <p class="todos-col">Group</p>
                <p class="todos-col">Due Date</p>
                <p class="todos-col">Actions</p>
            </div>

            @foreach (TodoViewModel todo in Model.Todos)
            {
                // rows read back from the cache are plain TodoViewModel, without their group
                TodoWithGroupNameViewModel? todoWithGroup = todo as TodoWithGroupNameViewModel;
                Guid groupId = todoWithGroup?.GroupId ?? Model.GroupId;

                bool isPending = todo.Status == nameof(Status.Pending);
                string statusAction = isPending ? "Complete" : "Activate";
                // string statusLabel = isPending ? "Mark complete" : "Set to pending";

                <div class="todo-row">

                    @if (todo.Status == nameof(Status.Pending))
                    {
                        <div class="todo-row__title">
                            <form class="todo-row__complete"
                                  asp-area="TodoMainApp"
                                  asp-controller="Todo"
                                  asp-action="Complete"
                                  asp-route-id="@todo.Id"
                                  asp-route-groupId="@Model.GroupId"
                                  asp-route-filter="@filter"
                                  method="post">
                                <input type="checkbox"
                                       class="todo-row__check"
                                       onchange="this.form.submit()"
                                       aria-label="Mark complete"/>
                            </form>
                            <a class="todo-row__name"
                               asp-area="TodoMainApp"
                               asp-controller="Todo"
                               asp-action="Details"
                               asp-route-id="@todo.Id">@todo.Name</a>
                        </div>
                    }
                    else
                    {
                        <div class="todo-row__title">
                            <form class="todo-row__complete"
                                  asp-area="TodoMainApp"
                                  asp-controller="Todo"
                                  asp-action="Activate"
                                  asp-route-id="@todo.Id"
                                  asp-route-groupId="@Model.GroupId"
                                  asp-route-filter="@filter"
                                  method="post">
                                <input type="checkbox"
                                       class="todo-row__check"
                                       onchange="this.form.submit()"
                                       aria-label="Mark complete"/>
                            </form>
                            <a class="todo-row__name"
                               asp-area="TodoMainApp"
                               asp-controller="Todo"
                               asp-action="Details"
                               asp-route-id="@todo.Id">@todo.Name</a>
                        </div>
                    }

                    <p class="todo-row__status todo-row__status--@(todo.Status?.ToLower())" data-label="Status">@todo.Status</p>
                    <p class="todo-row__priority todo-row__priority--@(todo.Priority?.ToLower())" data-label="Priority">@todo.Priority</p>
                    <p class="todo-row__group" data-label="Group">@todoWithGroup?.GroupName</p>
                    <p class="todo-row__due" data-label="Due Date">@todo.DueDate</p>

                    <div class="todo-row__actions">
                        <a class="todo-action todo-action--edit"
                           asp-area="TodoMainApp"
                           asp-controller="Todo"
                           asp-action="Edit"
                           asp-route-id="@todo.Id"
                           aria-label="Edit">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 20h9"/>
                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                            </svg>
                        </a>
                        <button type="button" class="todo-action todo-action--delete"
                                data-delete-trigger
                                data-delete-item="To Do"
                                data-delete-url="@Url.Action("Delete", "Todo", new { area = "TodoMainApp", todoId = todo.Id, groupId })"
                                aria-label="Delete">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="3 6 5 6 21 6"/>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                <line x1="10" y1="11" x2="10" y2="17"/>
                                <line x1="14" y1="11" x2="14" y2="17"/>
                            </svg>
                        </button>
                    </div>

                </div>
            }
        }
        else
        {
            <div class="todo-empty">You have no @activeFilter.ToString().ToLower() todos.</div>
        }

    </div>

    <partial name="_PaginationPartial" model='(Model.PageNumber, Model.TotalCount, (Func<int, string>)PageUrl)' />

</div>

<form method="post" asp-antiforgery="true" hidden></form>
<partial name="_DeleteTodoWarningPartial" model='("To Do", (string?)null, string.Empty)' />

@section Scripts {
    <script src="~/js/delete-warning.js" asp-append-version="true"></script>
}
