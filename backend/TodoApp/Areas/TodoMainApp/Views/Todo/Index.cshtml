@using TodoApp.Models.Data.Enums
@using TodoApp.Web.ViewModels.Todo
@using static TodoApp.GCommon.ApplicationConstants
@model PagedTodosViewModel

@{
    // keep the current tab (?filter=...) when moving between pages
    string? filter = Context.Request.Query["filter"];
    
    // no filter in the URL means All, because All = 0 is the enum's default
    Enum.TryParse(filter, true, out TodosSearchParameter activeFilter);

    string TabClass(TodosSearchParameter tab) =>
        tab == activeFilter ? "todo-tab todo-tab--active" : "todo-tab";

    // Model.PageNumber is 1-based, the "page" query parameter is 0-based
    int currentPage = Model.PageNumber - 1;
    int totalPages = (int)Math.Ceiling(Model.TotalCount / (double)TodosDefaultPageSize);

    bool hasPreviousPage = currentPage > 0;
    bool hasNextPage = currentPage + 1 < totalPages;

    // show at most 5 page numbers: up to 2 before and 2 after the current page
    int firstPage = Math.Max(0, currentPage - 2);
    int lastPage = Math.Min(totalPages - 1, currentPage + 2);

    string PageUrl(int page) => Url.Action("Index", "Todo", new { area = "TodoMainApp", id = Model.GroupId, page, filter })!;
}

@section Styles {
    <link rel="stylesheet" href="~/css/todo-index/todo-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/delete-todo-warning/delete-todo-warning.css" asp-append-version="true" />
}

<div class="todo-page">

    <div class="page-header">
        <h3 class="page-header__title">@Model.GroupName</h3>

        <div class="page-header__actions">
            <a class="group-edit"
               asp-area="TodoMainApp"
               asp-controller="Groups"
               asp-action="EditGroup"
               asp-route-id="@Model.GroupId">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9"/>
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                </svg>
                <span>Edit Group</span>
            </a>

            <button type="button" class="group-delete"
                    data-delete-trigger
                    data-delete-item="Group"
                    data-delete-url="@Url.Action("DeleteGroup", "Groups", new { area = "TodoMainApp", id = Model.GroupId })">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    <line x1="10" y1="11" x2="10" y2="17"/>
                    <line x1="14" y1="11" x2="14" y2="17"/>
                </svg>
                <span>Delete Group</span>
            </button>
        </div>
    </div>

    @* delete-group confirmation warning (are you sure? yes/no) will go here *@

    <div class="todo-toolbar">

        <div class="todo-tabs">
            <a class="@TabClass(TodosSearchParameter.All)"
               asp-area="TodoMainApp"
               asp-controller="Todo"
               asp-action="Index"
               asp-route-id="@Model.GroupId">
                @nameof(TodosSearchParameter.All)
            </a>
            <a class="@TabClass(TodosSearchParameter.Pending)"
               asp-area="TodoMainApp"
               asp-controller="Todo"
               asp-action="Index"
               asp-route-id="@Model.GroupId"
               asp-route-filter="@TodosSearchParameter.Pending"
               >@nameof(TodosSearchParameter.Pending)</a>
            <a class="@TabClass(TodosSearchParameter.Completed)"
               asp-area="TodoMainApp"
               asp-controller="Todo"
               asp-action="Index"
               asp-route-id="@Model.GroupId"
               asp-route-filter="@TodosSearchParameter.Completed"
               >@nameof(TodosSearchParameter.Completed)</a>
        </div>

        <div class="todo-toolbar__right">
            <div class="todo-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" class="todo-search__input" placeholder="Search todos..." />
            </div>

            <a class="todo-add"
               asp-area="TodoMainApp"
               asp-controller="Todo"
               asp-action="Create"
               asp-route-id="@Model.GroupId">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Add Todo</span>
            </a>
        </div>

    </div>

    <div class="todo-table">

        <div class="todo-table__head">
            <p class="todo-col todo-col--title">Title</p>
            <p class="todo-col">Status</p>
            <p class="todo-col">Priority</p>
            <p class="todo-col">Due Date</p>
            <p class="todo-col todo-col--actions">Actions</p>
        </div>

        @if (Model.Todos.Any())
        {
            @foreach (TodoViewModel todo in Model.Todos)
            {
                <div class="todo-row">
                    
                    @if (todo.Status == nameof(Status.Pending))
                    {
                        <div class="todo-row__title">
                            <form class="todo-row__complete"
                                  asp-area="TodoMainApp"
                                  asp-controller="Todo"
                                  asp-action="Complete"
                                  asp-route-id="@todo.Id"
                                  asp-route-groupId="@Model.GroupId"
                                  asp-route-page="@currentPage"
                                  asp-route-filter="@filter"
                                  method="post">
                                <input type="checkbox"
                                       class="todo-row__check"
                                       onchange="this.form.submit()"
                                       aria-label="Mark complete"/>
                            </form>
                            <a class="todo-row__name"
                               asp-area="TodoMainApp"
                               asp-controller="Todo"
                               asp-action="Details"
                               asp-route-id="@todo.Id">@todo.Name</a>
                        </div>
                    }
                    else
                    {
                        <div class="todo-row__title">
                            <form class="todo-row__complete"
                                  asp-area="TodoMainApp"
                                  asp-controller="Todo"
                                  asp-action="Activate"
                                  asp-route-id="@todo.Id"
                                  asp-route-groupId="@Model.GroupId"
                                  asp-route-page="@currentPage"
                                  asp-route-filter="@filter"
                                  method="post">
                                <input type="checkbox"
                                       class="todo-row__check"
                                       onchange="this.form.submit()"
                                       aria-label="Mark complete"/>
                            </form>
                            <a class="todo-row__name"
                               asp-area="TodoMainApp"
                               asp-controller="Todo"
                               asp-action="Details"
                               asp-route-id="@todo.Id">@todo.Name</a>
                        </div>
                    }

                    <p class="todo-row__cell todo-row__status todo-row__status--@(todo.Status?.ToLower())" data-label="Status">@todo.Status</p>
                    <p class="todo-row__cell todo-row__priority todo-row__priority--@(todo.Priority?.ToLower())" data-label="Priority">@todo.Priority</p>
                    <p class="todo-row__cell todo-row__due" data-label="Due Date">@todo.DueDate</p>

                    <div class="todo-row__actions">
                        <a class="todo-action todo-action--edit"
                           asp-area="TodoMainApp"
                           asp-controller="Todo"
                           asp-action="Edit"
                           asp-route-id="@todo.Id"
                           aria-label="Edit">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 20h9"/>
                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                            </svg>
                        </a>
                        <button type="button" class="todo-action todo-action--delete"
                                data-delete-trigger
                                data-delete-item="To Do"
                                data-delete-url="@Url.Action("Delete", "Todo", new { area = "TodoMainApp", todoId = todo.Id, groupId = Model.GroupId })"
                                aria-label="Delete">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="3 6 5 6 21 6"/>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                <line x1="10" y1="11" x2="10" y2="17"/>
                                <line x1="14" y1="11" x2="14" y2="17"/>
                            </svg>
                        </button>
                    </div>

                </div>
            }
        }
        else
        {
            <div class="todo-empty">No todos in this group yet.</div>
        }

    </div>

    @if (totalPages > 1)
    {
        <div class="todo-pagination">

            @if (hasPreviousPage)
            {
                <button type="button" class="todo-page-btn todo-page-btn--nav" aria-label="Previous"
                        onclick="location.href='@PageUrl(currentPage - 1)'">&lsaquo;</button>
            }

            @for (int page = firstPage; page <= lastPage; page++)
            {
                if (page == currentPage)
                {
                    <button type="button" class="todo-page-btn todo-page-btn--active" aria-current="page">@(page + 1)</button>
                }
                else
                {
                    <button type="button" class="todo-page-btn"
                            onclick="location.href='@PageUrl(page)'">@(page + 1)</button>
                }
            }

            @if (hasNextPage)
            {
                <button type="button" class="todo-page-btn todo-page-btn--nav" aria-label="Next"
                        onclick="location.href='@PageUrl(currentPage + 1)'">&rsaquo;</button>
            }

        </div>
    }

</div>

<form method="post" asp-antiforgery="true" hidden></form>
<partial name="_DeleteTodoWarningPartial" model='("To Do", (string?)null, Model.GroupId.ToString())' />

@section Scripts {
    <script src="~/js/delete-warning.js" asp-append-version="true"></script>
}
