@using TodoApp.Models.Comment
@using TodoApp.Models.Todo
@model TodoDetailsViewmodel

@{
    Guid groupId = Guid.Parse(TempData.Peek("id")!.ToString()!);
}

@section Styles {
    <link rel="stylesheet" href="~/css/todo-details/todo-details.css" asp-append-version="true" />
}

<div class="details-page">

    <div class="details-header">
        <a class="details-header__back"
           asp-area="TodoMainApp"
           asp-controller="Todo"
           asp-action="Index"
           asp-route-id="@groupId"
           aria-label="Back to todos">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
        </a>
        <h3 class="details-header__title">Todo Details</h3>
    </div>

    <div class="details-card">

        <div class="details-card__top">
            <div class="details-card__titlewrap">
                <input type="checkbox" class="details-card__check" aria-label="Mark complete" />
                <h2 class="details-card__title">@Model.Name</h2>
            </div>
            <span class="details-badge details-badge--@(Model.Priority?.ToLower())">@Model.Priority Priority</span>
        </div>

        <p class="details-card__desc">@Model.Description</p>

        <div class="details-fields">

            <div class="details-field">
                <p class="details-field__label">Status</p>
                <p class="details-field__value details-field__value--status-@(Model.Status?.ToLower())">@Model.Status</p>
            </div>

            <div class="details-field">
                <p class="details-field__label">Priority</p>
                <p class="details-field__value details-field__value--priority-@(Model.Priority?.ToLower())">@Model.Priority</p>
            </div>

            <div class="details-field">
                <p class="details-field__label">Group</p>
                <p class="details-field__value">@Model.GroupName</p>
            </div>

            <div class="details-field">
                <p class="details-field__label">Due Date</p>
                <p class="details-field__value">@Model.DueDate</p>
            </div>

            <div class="details-field">
                <p class="details-field__label">Created On</p>
                <p class="details-field__value">@Model.CreatedOn</p>
            </div>

        </div>

        <div class="details-actions">
            <button type="button" class="details-btn details-btn--edit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9"/>
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                </svg>
                <span>Edit</span>
            </button>
            <button type="button" class="details-btn details-btn--delete">Delete</button>
            <a class="details-btn details-btn--back"
               asp-area="TodoMainApp"
               asp-controller="Todo"
               asp-action="Index"
               asp-route-id="@groupId">Back</a>
        </div>

    </div>

    <div class="details-comments">

        <div class="details-comments__head">
            <h3 class="details-comments__title">Comments</h3>

            <button type="button" class="comment-add">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Add Comment</span>
            </button>
        </div>

        @if (Model.Comments.Any())
        {
            <div class="details-comments__list">
                @foreach (CommentViewModel comment in Model.Comments)
                {
                    <div class="comment-item">
                        <p class="comment-item__content">@comment.Content</p>

                        <div class="comment-item__actions">
                            <button type="button" class="comment-action comment-action--edit" aria-label="Edit comment">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 20h9"/>
                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                                </svg>
                            </button>
                            <button type="button" class="comment-action comment-action--delete" aria-label="Delete comment">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="3 6 5 6 21 6"/>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    <line x1="10" y1="11" x2="10" y2="17"/>
                                    <line x1="14" y1="11" x2="14" y2="17"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="details-comments__empty">There are no comments to this To Do</div>
        }

    </div>

</div>
