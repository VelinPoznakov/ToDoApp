@using TodoApp.Models.Comment
@using TodoApp.Models.Todo
@model TodoDetailsViewmodel

@{
}

<div>
    <h2>@Model.Name</h2>
    
    <p><@Model.Description</p>
    
    <h3>@Model.Priority</h3>
    <h3>@Model.Status</h3>
    
    <h3>@Model.GroupName</h3>
    
    <h3>@Model.DueDate</h3>
    
    <h3>@Model.CreatedOn</h3>
    
    @if (Model.Comments.Any())
    {
        <div>
            @foreach (CommentViewModel comment in Model.Comments)
            {
                <div>
                    <p>@comment.Content</p>
                
                    <p>Actions</p>
                </div>
            }
        </div>
    }
    else
    {
        <h3>There are no comments to this To Do</h3>
    }
    

    
    <div>
        actions
    </div>
</div>