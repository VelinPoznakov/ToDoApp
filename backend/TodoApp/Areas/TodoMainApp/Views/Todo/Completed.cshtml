@using TodoApp.Models.Todo
@using TodoApp.Web.ViewModels.Todo
@model AllTodosViewModel

@{
}

<div>
    <h2>Completed</h2>
    
    <div>
        <div>
            <p>Name</p>
            <p>Priority</p>
            <p>Status</p>
            <p>Due Date</p>
        </div>

        @if (Model.Todos.Any())
        {
            foreach (TodoViewModel todo in Model.Todos)
            {
                <div>
                    <a asp-area="TodoMainApp"
                       asp-controller="Todo"
                       asp-action="Activate"
                       asp-route-id="@todo.Id"
                       asp-route-groupId="@Model.GroupId">Activate</a>

                    <a
                        asp-area="TodoMainApp"
                        asp-controller="Todo"
                        asp-action="Details"
                        asp-route-id="@todo.Id">

                        <p>@todo.Name</p>
                        <p>@todo.Priority</p>
                        <p>@todo.Status</p>
                        <p>@todo.DueDate</p>
                    </a>
                </div>
            }
        }
        else
        {
            <p>Nothing is completed</p>
        }


    </div>
</div>
