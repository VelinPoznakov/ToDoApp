@using TodoApp.Models.Todo
@model CreateEditViewModel

@{
    Guid groupId = Guid.Parse(ViewData["groupId"]!.ToString()!);
}

@section Styles {
    <link rel="stylesheet" href="~/css/create-todo/create-todo.css" asp-append-version="true" />
}

<div class="create-page">

    <div class="create-header">
        <a class="create-header__back"
           asp-area="TodoMainApp"
           asp-controller="Todo"
           asp-action="Index"
           asp-route-id="@groupId"
           aria-label="Back to todos">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
        </a>
        <div class="create-header__heading">
            <h3 class="create-header__title">Add New Todo</h3>
            <p class="create-header__subtitle">Create a new task</p>
        </div>
    </div>

    <div class="create-card">

        <form class="create-form"
              asp-area="TodoMainApp"
              asp-controller="Todo"
              asp-action="Create"
              asp-route-id="@groupId"
              method="post">

            <div asp-validation-summary="ModelOnly" class="create-form__summary"></div>

            <div class="form-field">
                <label class="form-field__label" asp-for="Name">Title</label>
                <input class="form-field__input" asp-for="Name" placeholder="Enter todo title" />
                <span class="form-field__error" asp-validation-for="Name"></span>
            </div>

            <div class="form-field">
                <label class="form-field__label" asp-for="Description">Description</label>
                <textarea class="form-field__input form-field__input--textarea" asp-for="Description" placeholder="Enter todo description"></textarea>
                <span class="form-field__error" asp-validation-for="Description"></span>
            </div>

            <div class="form-row">

                <div class="form-field">
                    <label class="form-field__label" asp-for="Priority">Priority</label>
                    <select class="form-field__input form-field__input--select" asp-for="Priority">
                        <option value="" selected disabled>Select priority</option>
                        @foreach (string priority in Model.Priorities)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </select>
                    <span class="form-field__error" asp-validation-for="Priority"></span>
                </div>

                <div class="form-field">
                    <label class="form-field__label" asp-for="DueDate">Due Date</label>
                    <input class="form-field__input" asp-for="DueDate" type="date" />
                    <span class="form-field__error" asp-validation-for="DueDate"></span>
                </div>

            </div>

            <div class="create-actions">
                <a class="create-btn create-btn--cancel"
                   asp-area="TodoMainApp"
                   asp-controller="Todo"
                   asp-action="Index"
                   asp-route-id="@groupId">Cancel</a>
                <button type="submit" class="create-btn create-btn--save">Save Todo</button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
