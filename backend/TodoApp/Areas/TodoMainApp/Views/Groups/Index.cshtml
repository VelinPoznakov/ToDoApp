@using TodoApp.Models.Group
@model IEnumerable<AllGroupsViewModel>

@{
    int groupsCount = Model.Count();
    int count = 1;
}

@section Styles {
    <link rel="stylesheet" href="~/css/groups-index/groups-index.css" asp-append-version="true" />
}

<div class="groups-page">

    <div class="groups-header">
        <h3 class="groups-header__title">You have @groupsCount groups</h3>
    </div>

    <div class="groups-list__head">

        <h3 class="groups-list__head-label">Name</h3>

    </div>

    <div class="groups-list">

        @foreach (AllGroupsViewModel group in Model)
        {
            <a class="group-card"
                asp-area="TodoMainApp"
                asp-controller="Todo"
                asp-action="Index"
                asp-route-id="@group.Id">
                <p class="group-card__name">@group.Name</p>
                <p class="group-card__index">@count</p>
            </a>
            count++;
        }

    </div>



</div>
