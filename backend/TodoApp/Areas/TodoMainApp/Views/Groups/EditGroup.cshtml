@using TodoApp.Models.Group
@model CreateEditGroupViewModel

@{
    Guid groupId = Guid.Parse(ViewContext.RouteData.Values["id"]!.ToString()!);
}

@section Styles {
    <link rel="stylesheet" href="~/css/edit-group/edit-group.css" asp-append-version="true" />
}

<div class="create-page">

    <div class="create-header">
        <a class="create-header__back" href="#" data-back aria-label="Go back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
        </a>
        <div class="create-header__heading">
            <h3 class="create-header__title">Edit Group</h3>
            <p class="create-header__subtitle">Rename your group</p>
        </div>
    </div>

    <div class="create-card">

        <form class="create-form"
              asp-area="TodoMainApp"
              asp-controller="Groups"
              asp-action="EditGroup"
              asp-route-id="@groupId"
              method="post">

            <div asp-validation-summary="ModelOnly" class="create-form__summary"></div>

            <div class="form-field">
                <label class="form-field__label" asp-for="GroupName">Name</label>
                <input class="form-field__input" asp-for="GroupName" placeholder="Enter group name" />
                <span class="form-field__error" asp-validation-for="GroupName"></span>
            </div>

            <div class="create-actions">
                <a class="create-btn create-btn--cancel"
                   asp-area="TodoMainApp"
                   asp-controller="Todo"
                   asp-action="Index"
                   asp-route-id="@groupId">Cancel</a>
                <button type="submit" class="create-btn create-btn--save">Save Changes</button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
