@model IndexDashboardViewModel
@{
    int counter = 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page">
    
    <div class="page-header">
        <h3 class="page-header__title">Dashboard</h3>
        <p class="page-header__subtitle">Overview of your tasks</p>
    </div>
    
    <div class="stats-row">
        
        <a class="stat-card" asp-controller="Groups" asp-action="Index">
            <span class="stat-card__icon">
                <!-- Users icon -->
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M16 11c1.657 0 3-1.567 3-3.5S17.657 4 16 4s-3 1.567-3 3.5S14.343 11 16 11zM8 11c1.657 0 3-1.567 3-3.5S9.657 4 8 4 5 5.567 5 7.5 6.343 11 8 11z" stroke="#6C4CFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M2 20c0-3 4-5 8-5s8 2 8 5" stroke="#6C4CFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            
            <div class="stat-card__content">
                <p class="stat-card__title">Groups</p>
                <h3 class="stat-card__value">@Model.CountGroups</h3>
                <p class="stat-card__desc">All groups</p>
            </div>
        </a>
        
        <a class="stat-card">
            <span class="stat-card__icon">
                <!-- Clock icon -->
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="#F59E0B" stroke-width="1.5"/>
                    <path d="M12 7v6l4 2" stroke="#F59E0B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            
            <div class="stat-card__content">
                <p class="stat-card__title">Pending</p>
                <h3 class="stat-card__value">@Model.CountPendingTodos</h3>
                <p class="stat-card__desc">All pending todos</p>
            </div>
        </a>
        
        <a class="stat-card">
            <span class="stat-card__icon">
                <!-- Check icon -->
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            
            <div class="stat-card__content">
                <p class="stat-card__title">Completed</p>
                <h3 class="stat-card__value">@Model.CountCompletedTodos</h3>
                <p class="stat-card__desc">All completed todos</p>
            </div>
        </a>

    </div>
    
    <div class="todos-section">
        
        <div class="todos-section__head">
            <h4 class="todos-section__title">Due Date</h4>
            <h4 class="todos-section__viewall"><a asp-action="" asp-controller="" asp-area="">View All</a></h4>
        </div>
        
        @if (Model.Todos.Count() != 0)
        {
            <div class="todos-table__head">
                <p class="todos-col todos-col--title">Title</p>
                <p class="todos-col">Status</p>
                <p class="todos-col">Priority</p>
                <p class="todos-col">Group</p>
                <p class="todos-col">Due Date</p>
                <p class="todos-col">Actions</p>
            </div>

            @if (Model.Todos.Count() <= 5)
            {
                foreach (var todo in Model.Todos)
                {
                    <partial name="_TodoDashboeardDetails" model="@todo" />
                }
            }
            else
            {
                foreach (var todo in Model.Todos)
                {
                    if (counter >= 5)
                    { 
                        break;
                    }

                    <partial name="_TodoDashboeardDetails" model="@todo" />

                    counter++;
                }
            }
        }
        else
        {
            <h2>No Assignments After Due Date</h2>
        }

    </div>

</div>
